[Desktop Entry]
Type=Application
Name=Oracle Motion
GenericName=Motion Graphics Editor
Comment=Motion graphics and visual effects compositor
Exec=oracle-motion %F
TryExec=oracle-motion
Icon=app.oracle.oracle-motion
Terminal=false
StartupNotify=true
