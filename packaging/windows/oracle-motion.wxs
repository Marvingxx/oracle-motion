<?xml version="1.0" encoding="utf-8"?>
<!--
  Oracle Motion MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build oracle-motion.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files (or a folder the user picks), a Start Menu shortcut and,
  unless DESKTOPSHORTCUT=0 (the wizard's "Create a desktop shortcut" box), a desktop shortcut.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Oracle Motion"
      Manufacturer="Oracle"
      Version="$(var.Version)"
      UpgradeCode="6AF9D326-374D-4522-9941-8B0DF0428732"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Oracle Motion motion graphics and visual effects" Manufacturer="Oracle" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Oracle Motion is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- The setup wizard (installer-ui.wxs): pick the folder on a fresh install. -->
    <UIRef Id="OracleMotionUI" />

    <Icon Id="OracleMotionIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="OracleMotionIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Marvingxx/oracle-motion" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Marvingxx/oracle-motion" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Marvingxx/oracle-suite" />

    <!-- An upgrade, repair or silent reinstall goes where the installed copy already is: the App Paths
         "Path" value written below, or for releases before this installer change (no Path value; they
         could be put elsewhere with INSTALLFOLDER=...) the folder of the oracle-motion.exe that App Paths names. A
         "file" search with no FileSearch inside yields that file's folder. A folder passed on the
         command line (INSTALLFOLDER=...) wins. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Type="directory"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-motion.exe" Name="Path" />
    </Property>
    <Property Id="PREVIOUSEXEFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousExeFolder" Root="HKLM" Type="file"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-motion.exe" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both"
        Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <SetProperty Id="INSTALLFOLDER" Action="SetINSTALLFOLDERFromExe" Value="[PREVIOUSEXEFOLDER]"
        After="SetINSTALLFOLDER" Sequence="both" Condition="PREVIOUSEXEFOLDER AND NOT INSTALLFOLDER" />

    <!-- The desktop shortcut: on by default for a fresh install (a box in the wizard, or
         DESKTOPSHORTCUT=0 silently); an upgrade keeps what the installed copy chose, and adds none
         to an install from before this option. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="PREVIOUSDESKTOPSHORTCUT" Secure="yes">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKLM" Type="raw" Key="Software\Oracle Motion" Name="DesktopShortcut" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[PREVIOUSDESKTOPSHORTCUT]" After="SetINSTALLFOLDERFromExe" Sequence="both"
        Condition="WIX_UPGRADE_DETECTED" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Oracle Motion" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Oracle Motion" Level="1">
      <ComponentGroupRef Id="OracleMotionFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="OracleMotionFiles" Directory="INSTALLFOLDER">
      <Component Id="OracleMotionApp" Guid="E8D5E9AF-E002-411C-B22A-7EF6D40834BD">
        <File Id="OracleMotionExe" Source="$(var.BinDir)\oracle-motion.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Oracle Motion"
              Description="Oracle Motion motion graphics and visual effects" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="OracleMotionIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-motion.exe" Value="[#OracleMotionExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-motion.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />
        <!-- The desktop shortcut choice, for the next upgrade (empty: none). -->
        <RegistryValue Root="HKLM" Key="Software\Oracle Motion" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" />
      </Component>

      <Component Id="OracleMotionCli">
        <File Id="OracleMotionCliExe" Source="$(var.BinDir)\oracle-motion-cli.exe" KeyPath="yes" />
      </Component>

      <!-- A component under the user's profile folders needs an HKCU key path (ICE38, ICE43). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Oracle Motion" Description="Oracle Motion motion graphics and visual effects"
            Target="[#OracleMotionExe]" WorkingDirectory="INSTALLFOLDER" Icon="OracleMotionIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\Oracle Motion" Name="DesktopShortcut" Value="1" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
